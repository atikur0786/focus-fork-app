# Main process (Electron) — required for auth, GitHub, and backend sync
GITHUB_CLIENT_ID=
FOCUSFORK_BACKEND_URL=http://localhost:8080

# Dev server (5180 avoids conflict with other Vite apps on 5173)
VITE_DEV_SERVER_PORT=5180

# Feature flags
FEATURE_BACKEND_SYNC=true
FEATURE_STRICT_BACKEND_AUTH=false
FEATURE_DESKTOP_FALLBACK=false

# Renderer metadata (optional — surfaced in UI when set)
VITE_BACKEND_URL=http://localhost:8080
VITE_GITHUB_CLIENT_ID=
VITE_APP_VERSION=0.1.0
